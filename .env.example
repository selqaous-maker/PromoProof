# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON string of a Firebase Admin service account
# Used server-side for authoritative webhook entitlement writes and global admin settings reads.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# LEMON_SQUEEZY_CHECKOUT_URL: Optional hosted checkout URL if not using API session creation.
LEMON_SQUEEZY_CHECKOUT_URL=""

# LEMON_SQUEEZY_API_KEY: Secret API key for Lemon Squeezy Checkout Sessions (server-side only).
LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
LEMON_SQUEEZY_VARIANT_ID=""
LEMON_SQUEEZY_WEBHOOK_SECRET=""
